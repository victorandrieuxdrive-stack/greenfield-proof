generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ChunkState {
  id                   String   @id @default(cuid())
  chunkId              String   @unique
  status               String
  terminalNonRetryable Boolean  @default(false)
  supersededBy         String?
  mergeSha             String?
  reason               String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
